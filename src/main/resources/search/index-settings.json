{
  "settings": {
    "index": { "number_of_shards": 1, "number_of_replicas": 0 },
    "analysis": {
      "tokenizer": {
        "nori_mixed": { "type": "nori_tokenizer", "decompound_mode": "mixed" }
      },
      "analyzer": {
        "korean": {
          "type": "custom",
          "tokenizer": "nori_mixed",
          "filter": ["nori_part_of_speech", "lowercase"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "type":      { "type": "keyword" },
      "sourceId":  { "type": "long" },
      "titleKo":   { "type": "text", "analyzer": "korean" },
      "titleEn":   { "type": "text", "analyzer": "korean" },
      "bodyKo":    { "type": "text", "analyzer": "korean" },
      "bodyEn":    { "type": "text", "analyzer": "korean" },
      "url":       { "type": "keyword", "index": false },
      "createdAt": { "type": "date" },
      "isPrivate": { "type": "boolean" }
    }
  }
}
