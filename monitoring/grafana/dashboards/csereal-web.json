        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (page) (rate(http_requests_total{job=\"frontend\"}[5m])))",
          "legendFormat": "{{page}}",
          "range": true,
          "refId": "A"
