    {
      "type": "timeseries",
      "title": "요청률 (상위 10개 URI)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "URI 는 Spring 이 템플릿({id})으로 정규화한 값이다.",
