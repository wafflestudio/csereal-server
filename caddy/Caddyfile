{$URL} {
	tls {$CERTIFICATE} {$PRIVATE_KEY}

    header {
	    # enable HSTS
	    Strict-Transport-Security max-age=31536000;
    }

	# Frontend
	reverse_proxy host.docker.internal:3000

	# Backend
	reverse_proxy /api/* host.docker.internal:8080

	# Old file serving
	reverse_proxy /sites/default/files/* host.docker.internal:8080

    # Login
    reverse_proxy /oauth2/authorization/idsnucse host.docker.internal:8080 

	# Grafana — 팀에 공개. Grafana 자체 인증(계정)으로 막는다.
	# Prometheus(9090)는 열지 않는다 — 무인증이고 /api/v1/status/config 가 내부 구조를 그대로 준다.
	reverse_proxy /grafana* host.docker.internal:3001

	# Swagger — /swagger-ui.html 은 /swagger-ui/ 아래가 아니라 별도 매처가 필요하다
	reverse_proxy /swagger-ui.html host.docker.internal:8080
	reverse_proxy /swagger-ui/* host.docker.internal:8080
	reverse_proxy /api-docs/* host.docker.internal:8080
}
